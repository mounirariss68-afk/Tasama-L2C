# Tasama Mizan on Replit. Press Run: installs once, builds the web app, serves on one port.
# The world lives in PostgreSQL: open the Database tool, create a PostgreSQL database, and
# DATABASE_URL is set for you. Without it the app still runs, in browser-only mode, and says so.
modules = ["nodejs-20", "postgresql-16"]
run = "bash tools/replit-run.sh"
entrypoint = "apps/server/src/index.ts"

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm install --include=dev --no-audit --no-fund && npm run build"]
run = ["npm", "start"]
